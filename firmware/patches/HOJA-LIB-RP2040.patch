 // The config app said something: keeps a hold alive (it lapses after 5 s of silence)
 void mapper_app_heard(void);
 
+// --- techchase: Quick Remap (input/macros/macro_quick_remap.c) ---
+// Physical input `src` takes over what physical input `target` does by default, in every mode's
+// profile at once. src == target puts src back to its own default. A trigger click carries its
+// analog half along (to the target's analog half if the target is a trigger, else off).
+// RAM only; settings_commit_blocks() stores it.
+bool mapper_quick_assign(mapper_input_code_t src, mapper_input_code_t target);
+// Every mode's profile back to the board defaults (RAM only, as above)
+void mapper_quick_reset_all(void);
+// For the desktop tool: input `in`'s current and default output in the GameCube and Switch
+// profiles (-1 = nothing)
+void mapper_quick_describe(mapper_input_code_t in, int8_t *gc_cur, int8_t *gc_def, int8_t *sw_cur, int8_t *sw_def);
+
 #endif
