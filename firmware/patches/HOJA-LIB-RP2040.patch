+// techchase: the live view's report. After the shared header (bytes 1 to 14), big-endian u16s:
+//   [15..22] lx ly rx ry as the game gets them (after snapback and deadzone), centered on 2048
+//   [23..30] lx ly rx ry calibrated, before snapback and deadzone, centered on 2048
+//   [31..35] presses, bit n = input code n (INPUT_CODE_*), little-endian
+//   [36..39] LT and RT analog, 0 to 4095
+//   [40]     a counter, +1 per report, so the app sees dropped reports
+static void _webusb_put_u16be(uint8_t *at, int32_t value)
+{
+    uint16_t v = (uint16_t)(value < 0 ? 0 : (value > 0xFFFF ? 0xFFFF : value));
+    at[0] = (uint8_t)(v >> 8);
+    at[1] = (uint8_t)(v & 0xFF);
+}
+
+static void _webusb_put_sticks(uint8_t *at, const analog_data_s *s)
+{
+    _webusb_put_u16be(&at[0], (int32_t)s->lx + 2048);
+    _webusb_put_u16be(&at[2], (int32_t)s->ly + 2048);
+    _webusb_put_u16be(&at[4], (int32_t)s->rx + 2048);
+    _webusb_put_u16be(&at[6], (int32_t)s->ry + 2048);
+}
+
+static void _webusb_fill_techchase_live(uint8_t *report)
+{
+    static uint8_t counter = 0;
+    analog_data_s sticks;
+    mapper_input_s hovers;
+
+    report[0] = WEBUSB_INPUT_TECHCHASE;
+
+    analog_access_safe(&sticks, ANALOG_ACCESS_DEADZONE_DATA);
+    _webusb_put_sticks(&report[15], &sticks);
+    analog_access_safe(&sticks, ANALOG_ACCESS_SCALED_DATA);
+    _webusb_put_sticks(&report[23], &sticks);
+
+    hovers = mapper_get_translated_input();
+    memset(&report[31], 0, 5);
+    for (uint32_t i = 0; (i < (uint32_t)INPUT_CODE_MAX) && (i < 40u); i++)
+    {
+        if (hovers.presses[i])
+            report[31u + (i >> 3)] |= (uint8_t)(1u << (i & 7u));
+    }
+    _webusb_put_u16be(&report[36], hovers.inputs[INPUT_CODE_LT_ANALOG]);
+    _webusb_put_u16be(&report[38], hovers.inputs[INPUT_CODE_RT_ANALOG]);
+    report[40] = counter++;
+}
