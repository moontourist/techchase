+// --- techchase commands (WEBUSB_ID_TECHCHASE). Replies: [0xC0][cmd][...], 64 bytes. ---
+#define TC_PROTO           1
+#define TC_CMD_INFO        0 // -> proto, latch on, latch mode, report format, quick remap on
+#define TC_CMD_STATS       1 // -> latch_stats_s
+#define TC_CMD_STATS_RESET 2
+#define TC_CMD_LATCH       3 // [on]
+#define TC_CMD_ASSIGN      4 // [src][target] -> ok
+#define TC_CMD_RESET_ALL   5 // -> ok
+#define TC_CMD_MAP         6 // [page] -> page, count, count x {input, gc now, gc default, sw now, sw default, name[8]}
+#define TC_CMD_USB_MODE    7 // [core_reportformat_t] -> ok
+#define TC_MAP_PER_PAGE    4
+
+static void _webusb_techchase(const uint8_t *data, uint32_t size)
+{
+    uint8_t out[64] = {WEBUSB_ID_TECHCHASE, (size > 1) ? data[1] : 0xFF};
+    if (size < 2)
+        return;
+
+    switch (data[1])
+    {
+    case TC_CMD_INFO:
+    {
+        latch_stats_s st;
+        latch_stats_get(&st);
+        out[2] = TC_PROTO;
+        out[3] = latch_enabled() ? 1 : 0;
+        out[4] = st.mode & 0x7F;
+        out[5] = (uint8_t)core_current_reportformat();
+        out[6] = macro_quick_remap_active() ? 1 : 0;
+    }
+    break;
+
+    case TC_CMD_STATS:
+    {
+        latch_stats_s st;
+        latch_stats_get(&st);
+        memcpy(&out[2], &st, sizeof(st));
+    }
+    break;
+
+    case TC_CMD_STATS_RESET:
+        latch_stats_reset();
+        out[2] = 1;
+        break;
+
+    case TC_CMD_LATCH:
+        if (size < 3)
+            return;
+        latch_set_enabled(data[2] != 0);
+        latch_stats_reset();
+        out[2] = 1;
+        break;
+
+    case TC_CMD_ASSIGN:
+        if (size < 4)
+            return;
+        out[2] = macro_quick_remap_assign((int8_t)data[2], (int8_t)data[3]) ? 1 : 0;
+        break;
+
+    case TC_CMD_RESET_ALL:
+        macro_quick_remap_reset_all();
+        out[2] = 1;
+        break;
+
+    case TC_CMD_MAP:
+    {
+        if (size < 3)
+            return;
+        const hoja_config_s *cfg = hoja_config_get();
+        const uint8_t page = data[2];
+        uint8_t count = 0;
+        uint8_t *e = &out[4];
+        for (uint32_t i = (uint32_t)page * TC_MAP_PER_PAGE;
+             cfg && (i < MAPPER_INPUT_COUNT) && (count < TC_MAP_PER_PAGE); i++, count++)
+        {
+            const hoja_input_slot_cfg_s *slot = &cfg->inputs.slots[i];
+            int8_t gc_cur, gc_def, sw_cur, sw_def;
+            const bool used = hoja_input_slot_enabled(slot);
+            e[0] = used ? (uint8_t)slot->code : 0xFF;
+            mapper_quick_describe(used ? slot->code : -1, &gc_cur, &gc_def, &sw_cur, &sw_def);
+            e[1] = (uint8_t)gc_cur;
+            e[2] = (uint8_t)gc_def;
+            e[3] = (uint8_t)sw_cur;
+            e[4] = (uint8_t)sw_def;
+            memcpy(&e[5], slot->name, HOJA_INPUT_NAME_LEN);
+            e += 5 + HOJA_INPUT_NAME_LEN;
+        }
+        out[2] = page;
+        out[3] = count;
+    }
+    break;
+
+    case TC_CMD_USB_MODE:
+        if (size < 3)
+            return;
+        // The reply goes first: the mode changes ~20 ms later, re-enumerating the device
+        out[2] = hoja_request_usb_mode((core_reportformat_t)(int8_t)data[2]) ? 1 : 0;
+        break;
+
+    default:
+        return;
+    }
+
+    webusb_send_bulk(out, sizeof(out));
+}
