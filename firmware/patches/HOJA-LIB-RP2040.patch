+                if (d >= (int32_t)(USB_FRAME_US / 2))
+                    d -= (int32_t)USB_FRAME_US;
+                else if (d < -(int32_t)(USB_FRAME_US / 2))
+                    d += (int32_t)USB_FRAME_US;
+                int32_t p = _usb_phase_us + d / 8;
+                if (p < 0)
+                    p += (int32_t)USB_FRAME_US;
+                else if (p >= (int32_t)USB_FRAME_US)
+                    p -= (int32_t)USB_FRAME_US;
+                _usb_phase_us = p;
+            }
+            if (_usb_phase_n < 0xFFFFu)
+                _usb_phase_n++;
+        }
+    }
