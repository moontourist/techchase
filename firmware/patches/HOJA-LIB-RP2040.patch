+#define TASKS_LATCH_MARGIN_US 20
+#define TASKS_LATCH_STALE_US  300
+
+static inline void _tasks_latch_note(task_s *task, uint64_t runtime_us)
+{
+    if (runtime_us < 5000u && runtime_us > task->latch_runtime_us)
+        task->latch_runtime_us = (uint32_t)runtime_us;
+}
+
+static bool _tasks_latch_allows(const task_s *task, uint64_t now_us)
+{
+    bool valid;
+    uint32_t period = 0;
+    const uint32_t start = latch_next_start_us(&valid, &period);
+    if (!valid || (task->type_mask & (TASK_TYPE_RAPID | TASK_TYPE_REQUIRED)))
+        return true;
+    const int32_t left = (int32_t)(start - (uint32_t)now_us);
+    if (left <= 0)
+        return left < -TASKS_LATCH_STALE_US;
+    const uint32_t need = task->latch_runtime_us + TASKS_LATCH_MARGIN_US;
+    if (need < (uint32_t)left)
+        return true;
+    if (need >= period / 2)
+        return (uint32_t)left > period / 2;
+    return false;
+}
