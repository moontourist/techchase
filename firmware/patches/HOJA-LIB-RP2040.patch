diff --git a/include/utilities/latch.h b/include/utilities/latch.h
new file mode 100644
index 0000000..a202b77
--- /dev/null
+++ b/include/utilities/latch.h
@@ -0,0 +1,96 @@
+#ifndef UTILITIES_LATCH_H
+#define UTILITIES_LATCH_H
+
+// Input late-latch (techchase).
+//
+// The buttons are read once per report. What matters for latency is how old that read is when the
+// host or console actually takes the report ("input age"). Stock firmware starts the read on a
+// timer or on the USB frame callback (which runs whenever the task loop next reaches the USB stack),
+// so the read lands at an arbitrary point before the hand-off: up to ~1 ms early.
+//
+// This module learns WHEN the hand-off happens, from interrupt-time timestamps:
+//  * USB: the phase of the host's IN poll within the 1 ms frame (SOF interrupt -> IN complete)
+//  * Joybus: the console's or adapter's poll period (poll interrupt -> poll interrupt)
+// and starts each read `lead` microseconds before the next predicted hand-off, where lead is the
+// measured read-to-ready time plus a guard that widens itself when a hand-off is missed.
+//
+// All times are time_us_32() (wraps every ~71 minutes; every comparison is wrap-safe).
+
+#include <stdint.h>
+#include <stdbool.h>
+
+typedef enum
+{
+    LATCH_MODE_OFF        = 0, // No transport using it
+    LATCH_MODE_USB_FRAME  = 1, // USB, still learning the host's poll phase: stock frame trigger
+    LATCH_MODE_USB_LATE   = 2, // USB, reads scheduled against the host's poll
+    LATCH_MODE_JB_FREE    = 3, // Joybus, polls irregular: stock 1 ms timer
+    LATCH_MODE_JB_LOCKED  = 4, // Joybus, reads scheduled against the next poll
+} latch_mode_t;
+
+// Reported over WebUSB (WEBUSB_ID_TECHCHASE / TC_CMD_STATS). Little-endian, packed.
+typedef struct __attribute__((packed))
+{
+    uint8_t  version;     // LATCH_STATS_VERSION
+    uint8_t  mode;        // latch_mode_t
+    uint16_t guard_us;    // Safety margin currently added to the lead
+    uint32_t count;       // Hand-offs measured since the last reset
+    uint32_t age_min_us;  // Input age at hand-off: button read start -> host/console takes it
+    uint32_t age_max_us;
+    uint32_t age_avg_us;
+    uint32_t misses;      // Hand-offs that got an older read than the one scheduled for them
+    uint32_t phase_us;    // USB: host poll offset after SOF. Joybus: poll period.
+    uint32_t lead_us;     // How long before the hand-off each read starts
+    uint32_t read_us;     // Newest input read's duration (matrix + triggers + processing)
+    uint32_t read_max_us; // Longest read since the last reset
+} latch_stats_s;
+
+#define LATCH_STATS_VERSION 1
+
+// A/B switch (WebUSB): off is the stock timing exactly, for comparison. On by default, not saved.
+void latch_set_enabled(bool enabled);
+bool latch_enabled(void);
+
+// --- The input read (hover task) ---
+void     latch_input_read_begin(void);
+void     latch_input_read_end(void);
+uint32_t latch_input_read_us(void);       // When the newest finished read started
+
+// --- Stats ---
+void latch_stats_get(latch_stats_s *out);
+void latch_stats_reset(void);
+
+// --- USB ---
+// Start for a transport that sends a report every frame (1 ms). Others stay stock.
+void latch_usb_start(void);
+void latch_usb_stop(void);
+// Late mode on: the task loop calls this every pass; true once it is time to read for the next poll
+bool latch_usb_active(void);
+bool latch_usb_due(void);
+// A report was armed in the endpoint, built from the read that started at input_us
+void latch_usb_armed(uint32_t input_us);
+// The endpoint still holds the previous report while this one waits to go. Returns true when the
+// caller should drop this report: on the schedule, the previous one is a frame late, and sending
+// behind it would keep every report after it a frame late too. Dropping one puts the next back in
+// phase.
+bool latch_usb_endpoint_busy(void);
+// Interrupt context (tud_event_hook_cb)
+void latch_usb_sof_isr(void);
+void latch_usb_xfer_isr(void);
+
+// --- Joybus (GameCube port) ---
+void latch_jb_start(void);
+void latch_jb_stop(void);
+// Interrupt context, on a poll command, before answering. Time read inline by the caller.
+void latch_jb_poll_isr(uint32_t poll_us);
+// The report snapshot the next poll answers with was just written from the read at input_us
+void latch_jb_snapshot(uint32_t input_us);
+bool latch_jb_locked(void);
+// Locked: true once it is time to read for the next predicted poll
+bool latch_jb_due(void);
+
+// For the task loop: the next read start, so optional tasks that would still be running then
+// wait a pass, and the spacing of reads (USB frame / poll period)
+uint32_t latch_next_start_us(bool *valid, uint32_t *period_us);
+
+#endif
