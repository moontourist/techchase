+// ---------------------------------------------------------------------------------------------
+// techchase: Quick Remap. One change is written to every mode's profile, so "Z does what X
+// does" means the same on Switch, Slippi and PC. Targets are a button's DEFAULT job, so a swap is
+// two steps in either order, and chains never drift.
+// ---------------------------------------------------------------------------------------------
+
+// Run once per remap, not per report: kept in flash (the rest of this file runs from RAM)
+
+typedef struct
+{
+    inputConfigSlot_s    *slots;
+    const int8_t         *codes;
+    const uint16_t       *statics;
+    mapper_output_type_t *types;
+} _mapper_profile_ref_s;
+
+#define MAPPER_PROFILE_REFS_MAX (6 + WII_PROFILE_MAX)
+
+__in_flash("mapper_quick") static uint8_t _mapper_profile_refs(_mapper_profile_ref_s *out)
+{
+    uint8_t n = 0;
+    out[n++] = (_mapper_profile_ref_s){input_config->input_profile_switch,   default_codes_switch,   default_static_switch,   _switch_output_types};
+    out[n++] = (_mapper_profile_ref_s){input_config->input_profile_snes,     default_codes_snes,     default_static_snes,     _snes_output_types};
+    out[n++] = (_mapper_profile_ref_s){input_config->input_profile_n64,      default_codes_n64,      default_static_n64,      _n64_output_types};
+    out[n++] = (_mapper_profile_ref_s){input_config->input_profile_gamecube, default_codes_gamecube, default_static_gamecube, _gamecube_output_types};
+    out[n++] = (_mapper_profile_ref_s){input_config->input_profile_xinput,   default_codes_xinput,   default_static_xinput,   _xinput_output_types};
+    out[n++] = (_mapper_profile_ref_s){input_config->input_profile_sinput,   default_codes_sinput,   default_static_sinput,   _sinput_output_types};
+    for(int p = 0; p < WII_PROFILE_MAX; p++)
+        out[n++] = (_mapper_profile_ref_s){_mapper_wii_slots((mapper_wii_profile_t)p), default_codes_wii[p], default_static_wii[p], _wii_output_types};
+    return n;
+}
+
+// Slot `dst` set as _mapper_set_defaults would set it, but with input `from`'s default output
+// (from < 0: nothing)
+__in_flash("mapper_quick") static void _mapper_slot_default_from(const _mapper_profile_ref_s *p, int dst, int from)
+{
+    inputConfigSlot_s *slot = &p->slots[dst];
+    int8_t output_code = (from >= 0) ? p->codes[from] : -1;
+    const uint16_t static_out = (from >= 0) ? p->statics[from] : 0;
+
+    if(output_code >= MAPPER_OVERRIDE_SLOT_0)
+    {
+        mapper_override_s or = _mapper_overrides[output_code-MAPPER_OVERRIDE_SLOT_0];
+        output_code = or.output_code;
+        slot->static_output = or.static_output;
+        slot->threshold_delta = or.threshold_delta;
+    }
+    else
+    {
+        slot->static_output = static_out ? static_out : (0xFFF+1);
+        slot->threshold_delta = 2048;
+    }
+
+    slot->output_code = output_code;
+
+    if(output_code < 0)
+    {
+        slot->output_mode = 0;
+        return;
+    }
+
+    switch(input_static.input_info[dst].input_type)
+    {
+        case MAPPER_INPUT_TYPE_HOVER:
+        case MAPPER_INPUT_TYPE_JOYSTICK:
+        switch(p->types[output_code])
+        {
+            case MAPPER_OUTPUT_DPAD:
+            slot->output_mode = MAPPER_OUTPUT_MODE_THRESHOLD;
+            break;
+
+            case MAPPER_OUTPUT_HOVER:
+            case MAPPER_OUTPUT_JOYSTICK:
+            slot->output_mode = MAPPER_OUTPUT_MODE_PASSTHROUGH;
+            break;
+
+            default:
+            slot->output_mode = 0;
+            break;
+        }
+        break;
+
+        default:
+        slot->output_mode = 0;
+        break;
+    }
+}
+
+// A trigger click's analog half, where the board has one
+__in_flash("mapper_quick") static int _mapper_trigger_analog(int code)
+{
+    int analog = -1;
+    if(code == INPUT_CODE_LT) analog = INPUT_CODE_LT_ANALOG;
+    else if(code == INPUT_CODE_RT) analog = INPUT_CODE_RT_ANALOG;
+    if(analog >= 0 && input_static.input_info[analog].input_type != MAPPER_INPUT_TYPE_HOVER)
+        analog = -1;
+    return analog;
+}
+
+__in_flash("mapper_quick") bool mapper_quick_assign(mapper_input_code_t src, mapper_input_code_t target)
+{
+    if(!input_config || src < 0 || src >= MAPPER_INPUT_COUNT || target < 0 || target >= MAPPER_INPUT_COUNT)
+        return false;
+
+    _mapper_profile_ref_s refs[MAPPER_PROFILE_REFS_MAX];
+    const uint8_t n = _mapper_profile_refs(refs);
+
+    const int src_analog = _mapper_trigger_analog(src);
+    const int target_analog = _mapper_trigger_analog(target);
+
+    for(uint8_t i = 0; i < n; i++)
+    {
+        _mapper_slot_default_from(&refs[i], src, target);
+        // R mapped to L: R's analog gives L's analog (light shield). R mapped to Z: R's analog off,
+        // or a half press would still shield
+        if(src_analog >= 0)
+            _mapper_slot_default_from(&refs[i], src_analog, target_analog);
+    }
+
+    mapper_init();
+    return true;
+}
+
+__in_flash("mapper_quick") void mapper_quick_reset_all(void)
+{
+    if(!input_config)
+        return;
+
+    _mapper_profile_ref_s refs[MAPPER_PROFILE_REFS_MAX];
+    const uint8_t n = _mapper_profile_refs(refs);
+    for(uint8_t i = 0; i < n; i++)
+    {
+        for(int in = 0; in < MAPPER_INPUT_COUNT; in++)
+            _mapper_slot_default_from(&refs[i], in, in);
+    }
+
+    mapper_init();
+}
+
+__in_flash("mapper_quick") void mapper_quick_describe(mapper_input_code_t in, int8_t *gc_cur, int8_t *gc_def, int8_t *sw_cur, int8_t *sw_def)
+{
+    *gc_cur = *gc_def = *sw_cur = *sw_def = -1;
+    if(!input_config || in < 0 || in >= MAPPER_INPUT_COUNT)
+        return;
+    *gc_cur = input_config->input_profile_gamecube[in].output_code;
+    *gc_def = default_codes_gamecube[in];
+    *sw_cur = input_config->input_profile_switch[in].output_code;
+    *sw_def = default_codes_switch[in];
+}
