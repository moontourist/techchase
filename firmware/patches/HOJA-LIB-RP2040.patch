+static uint32_t _jb_next_poll(uint32_t now)
+{
+    const uint32_t period = _jb_period_us;
+    uint32_t t = _jb_last_poll_us + period;
+    uint8_t guard = 0;
+    while ((int32_t)(now - t) > (int32_t)(period / 2) && guard++ < 64)
+        t += period;
+    return t;
+}
