diff --git a/src/input/macros/macro_quick_remap.c b/src/input/macros/macro_quick_remap.c
new file mode 100644
index 0000000..2819838
--- /dev/null
+++ b/src/input/macros/macro_quick_remap.c
@@ -0,0 +1,301 @@
+// techchase: Quick Remap on the controller. See input/macros/macro_quick_remap.h for the flow.
+
+#include "input/macros/macro_quick_remap.h"
+
+#include <string.h>
+
+#include "hoja.h"
+#include "input/mapper.h"
+#include "input/input_config.h"
+#include "devices/rgb.h"
+#include "devices/haptics.h"
+#include "utilities/settings.h"
+#include "pico.h"
+
+#define QR_ENTER_HOLD_US     1500000u
+#define QR_RESET_ALL_HOLD_US 3000000u
+#define QR_IDLE_EXIT_US      20000000u
+
+#define QR_TICK_ON_US        45000u
+#define QR_TICK_OFF_US       70000u
+#define QR_TICK_AMPLITUDE    200
+
+typedef enum
+{
+    QR_IDLE,
+    QR_ARMING,      // Combo held, counting
+    QR_SETTLE,      // On; waiting for every button to come up before picking
+    QR_PICK_SRC,
+    QR_PICK_TARGET,
+} qr_state_t;
+
+static volatile qr_state_t _st = QR_IDLE;
+static uint64_t _t_arm = 0;
+static uint64_t _t_activity = 0;
+static int8_t   _src = -1;
+static bool     _down[MAPPER_INPUT_COUNT];
+static uint64_t _down_at[MAPPER_INPUT_COUNT];
+static bool     _ignore_release[MAPPER_INPUT_COUNT];
+static bool     _mod_was_down = false;
+static volatile bool _block_until_mod_up = false;
+
+// --- Board inputs ---
+
+static int8_t _mod_code = -2; // -2: not looked up yet
+static bool   _candidate[MAPPER_INPUT_COUNT];
+
+static void _lookup(void)
+{
+    if (_mod_code != -2)
+        return;
+
+    const hoja_config_s *cfg = hoja_config_get();
+    _mod_code = INPUT_CODE_HOME;
+    if (cfg && cfg->shipping_macro_code[0] != INPUT_CODE_UNUSED)
+        _mod_code = (int8_t)cfg->shipping_macro_code[0];
+
+    memset(_candidate, 0, sizeof(_candidate));
+    if (!cfg)
+        return;
+    for (int i = 0; i < MAPPER_INPUT_COUNT; i++)
+    {
+        const hoja_input_slot_cfg_s *slot = &cfg->inputs.slots[i];
+        if (!hoja_input_slot_enabled(slot) || slot->type != INPUT_TYPE_DIGITAL)
+            continue;
+        if (slot->code < 0 || slot->code >= MAPPER_INPUT_COUNT || slot->code == _mod_code)
+            continue;
+        _candidate[slot->code] = true;
+    }
+}
+
+static inline bool _pressed(const mapper_input_s *input, int code)
+{
+    return (code >= 0) && (code < MAPPER_INPUT_COUNT) && input->presses[code];
+}
+
+static bool _any_candidate_down(const mapper_input_s *input)
+{
+    for (int i = 0; i < MAPPER_INPUT_COUNT; i++)
+    {
+        if (_candidate[i] && input->presses[i])
+            return true;
+    }
+    return false;
+}
+
+// --- Rumble ticks ---
+
+static uint8_t  _ticks_left = 0;
+static bool     _tick_on = false;
+static uint64_t _tick_next_us = 0;
+
+static void _ticks(uint8_t n)
+{
+    _ticks_left = n;
+    _tick_next_us = 0;
+}
+
+static void _ticks_task(uint64_t now)
+{
+    if (!_ticks_left && !_tick_on)
+        return;
+    if (now < _tick_next_us)
+        return;
+
+    if (_tick_on)
+    {
+        haptics_set_std(0, true);
+        _tick_on = false;
+        _tick_next_us = now + QR_TICK_OFF_US;
+    }
+    else if (_ticks_left)
+    {
+        haptics_set_std(QR_TICK_AMPLITUDE, false);
+        _tick_on = true;
+        _ticks_left--;
+        _tick_next_us = now + QR_TICK_ON_US;
+    }
+}
+
+// --- Flow ---
+
+static void _qr_enter(uint64_t now)
+{
+    _st = QR_SETTLE;
+    _src = -1;
+    _t_activity = now;
+    memset(_down, 0, sizeof(_down));
+    memset(_ignore_release, 0, sizeof(_ignore_release));
+    rgb_set_pulsing(COLOR_PURPLE);
+    _ticks(1);
+}
+
+static void _qr_exit(void)
+{
+    _st = QR_IDLE;
+    _src = -1;
+    _block_until_mod_up = true;
+    rgb_clear_pulsing();
+    rgb_send_notification(COLOR_WHITE);
+    _ticks(1);
+}
+
+static void _store(void)
+{
+    // Stored right away: unplugging mid-session keeps every change made so far
+    settings_commit_blocks();
+}
+
+static void _picked(int8_t code, uint64_t now)
+{
+    _t_activity = now;
+
+    if (_st == QR_PICK_SRC)
+    {
+        _src = code;
+        _st = QR_PICK_TARGET;
+        _ticks(1);
+        return;
+    }
+
+    mapper_quick_assign(_src, code);
+    _store();
+    rgb_send_notification((code == _src) ? COLOR_CYAN : COLOR_GREEN);
+    _ticks(2);
+    _src = -1;
+    _st = QR_PICK_SRC;
+}
+
+void macro_quick_remap(uint64_t now, mapper_input_s *input)
+{
+    _lookup();
+    _ticks_task(now);
+
+    const bool mod_down = _pressed(input, _mod_code);
+    if (_block_until_mod_up && !mod_down)
+        _block_until_mod_up = false;
+
+    switch (_st)
+    {
+    case QR_IDLE:
+        if (mod_down && _pressed(input, INPUT_CODE_START))
+        {
+            _st = QR_ARMING;
+            _t_arm = now;
+        }
+        break;
+
+    case QR_ARMING:
+        if (!(mod_down && _pressed(input, INPUT_CODE_START)))
+            _st = QR_IDLE;
+        else if ((now - _t_arm) >= QR_ENTER_HOLD_US)
+            _qr_enter(now);
+        break;
+
+    case QR_SETTLE:
+        if (!mod_down && !_any_candidate_down(input))
+        {
+            _st = QR_PICK_SRC;
+            _t_activity = now;
+        }
+        else if ((now - _t_activity) >= QR_IDLE_EXIT_US)
+        {
+            _qr_exit();
+        }
+        break;
+
+    case QR_PICK_SRC:
+    case QR_PICK_TARGET:
+    {
+        if (mod_down && !_mod_was_down)
+        {
+            _qr_exit();
+            break;
+        }
+
+        int8_t released = -1;
+        for (int c = 0; c < MAPPER_INPUT_COUNT; c++)
+        {
+            if (!_candidate[c])
+                continue;
+
+            const bool d = input->presses[c];
+            if (d && !_down[c])
+            {
+                _down_at[c] = now;
+                _t_activity = now;
+            }
+
+            // Start held 3 s: everything back to default; its release is not a pick
+            if (d && (c == INPUT_CODE_START) && !_ignore_release[c] && ((now - _down_at[c]) >= QR_RESET_ALL_HOLD_US))
+            {
+                mapper_quick_reset_all();
+                _store();
+                rgb_send_notification(COLOR_ORANGE);
+                _ticks(3);
+                _ignore_release[c] = true;
+                _src = -1;
+                _st = QR_PICK_SRC;
+                _t_activity = now;
+            }
+
+            if (!d && _down[c])
+            {
+                if (_ignore_release[c])
+                    _ignore_release[c] = false;
+                else if (released < 0)
+                    released = (int8_t)c; // A button counts when it comes back up
+            }
+            _down[c] = d;
+        }
+
+        if (released >= 0)
+            _picked(released, now);
+        else if ((now - _t_activity) >= QR_IDLE_EXIT_US)
+            _qr_exit();
+    }
+    break;
+    }
+
+    _mod_was_down = mod_down;
+}
+
+bool __not_in_flash_func(macro_quick_remap_game_hold)(const mapper_input_s *input)
+{
+    if (_st != QR_IDLE)
+        return true;
+    _lookup();
+    return _pressed(input, _mod_code) && _pressed(input, INPUT_CODE_START);
+}
+
+bool macro_quick_remap_blocks_shutdown(const mapper_input_s *input)
+{
+    if ((_st != QR_IDLE) || _block_until_mod_up)
+        return true;
+    _lookup();
+    return _pressed(input, _mod_code) && _any_candidate_down(input);
+}
+
+bool macro_quick_remap_active(void)
+{
+    return _st != QR_IDLE;
+}
+
+bool macro_quick_remap_assign(mapper_input_code_t src, mapper_input_code_t target)
+{
+    _lookup();
+    if (src < 0 || src >= MAPPER_INPUT_COUNT || target < 0 || target >= MAPPER_INPUT_COUNT)
+        return false;
+    if (!_candidate[src] || !_candidate[target])
+        return false;
+    if (!mapper_quick_assign(src, target))
+        return false;
+    _store();
+    return true;
+}
+
+void macro_quick_remap_reset_all(void)
+{
+    mapper_quick_reset_all();
+    _store();
+}
