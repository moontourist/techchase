+static void _webusb_techchase(const uint8_t *data, uint32_t size)
+{
+    uint8_t out[64] = {WEBUSB_ID_TECHCHASE, (size > 1) ? data[1] : 0xFF};
+    if (size < 2)
+        return;
+
+    switch (data[1])
+    {
+    case TC_CMD_INFO:
+    {
+        latch_stats_s st;
+        latch_stats_get(&st);
+        out[2] = TC_PROTO;
+        out[3] = latch_enabled() ? 1 : 0;
+        out[4] = st.mode & 0x7F;
+        out[5] = (uint8_t)core_current_reportformat();
+        out[6] = macro_quick_remap_active() ? 1 : 0;
+        out[7] = macro_quick_remap_unsaved() ? 1 : 0;
+    }
+    break;
+
+    case TC_CMD_STATS:
+    {
+        latch_stats_s st;
+        latch_stats_get(&st);
+        memcpy(&out[2], &st, sizeof(st));
+    }
+    break;
+
+    case TC_CMD_STATS_RESET:
+        latch_stats_reset();
+        out[2] = 1;
+        break;
+
+    case TC_CMD_LATCH:
+        if (size < 3)
+            return;
+        latch_set_enabled(data[2] != 0);
+        latch_stats_reset();
+        out[2] = 1;
+        break;
+
+    case TC_CMD_ASSIGN:
+        if (size < 4)
+            return;
+    {
+        const bool save = !((size > 4) && (data[4] & TC_FLAG_NO_SAVE));
+        out[2] = macro_quick_remap_assign((int8_t)data[2], (int8_t)data[3], save) ? 1 : 0;
+        out[3] = macro_quick_remap_unsaved() ? 1 : 0;
+    }
+    break;
+
+    case TC_CMD_RESET_ALL:
+    {
+        const bool save = !((size > 2) && (data[2] & TC_FLAG_NO_SAVE));
+        macro_quick_remap_reset_all(save);
+        out[2] = 1;
+        out[3] = macro_quick_remap_unsaved() ? 1 : 0;
+    }
