diff --git a/src/utilities/latch.c b/src/utilities/latch.c
new file mode 100644
index 0000000..cbb1ebe
--- /dev/null
+++ b/src/utilities/latch.c
@@ -0,0 +1,670 @@
+// Input late-latch (techchase). See utilities/latch.h for the idea.
+
+#include "utilities/latch.h"
+
+#include <string.h>
+
+#include "hardware/timer.h"
+#include "hardware/sync.h"
+
+#if defined(PICO_RP2040) || defined(PICO_RP2350)
+#include "hardware/structs/usb.h"
+#define LATCH_HAS_USB_DPRAM 1
+#else
+#define LATCH_HAS_USB_DPRAM 0
+#endif
+
+// a at or after b, wrap-safe
+#define AT_OR_AFTER(a, b) ((int32_t)((uint32_t)(a) - (uint32_t)(b)) >= 0)
+
+// --- Tuning ---
+#define USB_FRAME_US          1000u
+#define USB_PHASE_LEARN_N     32u    // Takes measured before the schedule takes over
+#define USB_GUARD_INIT_US     120u
+#define USB_GUARD_MIN_US      60u    // Covers IN token -> IN complete interrupt (~30-40 us)
+#define USB_GUARD_MAX_US      500u
+#define USB_GUARD_MISS_STEP   40u
+#define USB_READY_CAP_US      900u   // A read+arm longer than this was a stall, not the norm
+#define USB_TAKE_SLOW_US      1300u  // Host polling slower than every frame: stay stock
+
+#define JB_LOCK_N             8u     // Steady polls in a row before locking
+#define JB_PERIOD_MIN_US      300u
+#define JB_PERIOD_MAX_US      50000u
+#define JB_GUARD_INIT_US      80u
+#define JB_GUARD_MIN_US       40u
+#define JB_GUARD_MAX_US       400u
+#define JB_GUARD_MISS_STEP    20u
+
+#define READY_DEFAULT_US      200u   // Read -> ready, before any measurement
+#define GOOD_RUN_SHRINK       2000u  // Hand-offs on time in a row before the guard shrinks
+#define GUARD_SHRINK_STEP     5u
+
+// Largest of a value over the last 1000..2000 samples: tracks the worst normal case, forgets a
+// one-off stall within a couple of seconds
+typedef struct
+{
+    uint32_t cur;
+    uint32_t prev;
+    uint16_t n;
+} winmax_s;
+
+static void _winmax_reset(winmax_s *w)
+{
+    w->cur = 0;
+    w->prev = 0;
+    w->n = 0;
+}
+
+static void _winmax_add(winmax_s *w, uint32_t v)
+{
+    if (v > w->cur)
+        w->cur = v;
+    if (++w->n >= 1000u)
+    {
+        w->prev = w->cur;
+        w->cur = 0;
+        w->n = 0;
+    }
+}
+
+static uint32_t _winmax(const winmax_s *w)
+{
+    uint32_t m = (w->cur > w->prev) ? w->cur : w->prev;
+    return m ? m : READY_DEFAULT_US;
+}
+
+static volatile bool _enabled = true;
+
+void latch_set_enabled(bool enabled)
+{
+    _enabled = enabled;
+}
+
+bool latch_enabled(void)
+{
+    return _enabled;
+}
+
+// ---------------------------------------------------------------------------------------------
+// Input read
+// ---------------------------------------------------------------------------------------------
+
+static volatile uint32_t _read_begin_us = 0;
+static volatile uint32_t _read_done_start_us = 0;
+static volatile uint32_t _read_dur_us = 0;
+static volatile uint32_t _read_max_us = 0;
+
+// A scheduled read was triggered and has not started: the task loop holds everything optional
+// until it does (a task slipped in between would push the read past its hand-off)
+static volatile bool     _read_pending = false;
+static volatile uint32_t _read_pending_at = 0;
+
+static void _read_trigger(uint32_t now)
+{
+    _read_pending_at = now;
+    _read_pending = true;
+}
+
+void latch_input_read_begin(void)
+{
+    _read_begin_us = time_us_32();
+    _read_pending = false;
+}
+
+void latch_input_read_end(void)
+{
+    const uint32_t begin = _read_begin_us;
+    const uint32_t d = time_us_32() - begin;
+    _read_dur_us = d;
+    if (d > _read_max_us)
+        _read_max_us = d;
+    _read_done_start_us = begin;
+}
+
+uint32_t latch_input_read_us(void)
+{
+    return _read_done_start_us;
+}
+
+// ---------------------------------------------------------------------------------------------
+// Stats (hand-offs are counted in interrupt context)
+// ---------------------------------------------------------------------------------------------
+
+static volatile latch_mode_t _mode = LATCH_MODE_OFF;
+static volatile uint32_t _st_count = 0;
+static volatile uint32_t _st_min = UINT32_MAX;
+static volatile uint32_t _st_max = 0;
+static volatile uint64_t _st_sum = 0;
+static volatile uint32_t _st_misses = 0;
+static volatile uint32_t _good_run = 0;
+static volatile uint16_t _guard_us = 0;
+static uint16_t _guard_min_us = 0;
+static uint16_t _guard_max_us = 0;
+static uint16_t _guard_step_us = 0;
+static winmax_s _ready;
+
+static void __not_in_flash_func(_stat_add)(uint32_t age)
+{
+    // An age over 100 ms is a stall or a fresh start, not a hand-off worth averaging
+    if (age > 100000u)
+        return;
+    _st_count++;
+    _st_sum += age;
+    if (age < _st_min)
+        _st_min = age;
+    if (age > _st_max)
+        _st_max = age;
+}
+
+static void __not_in_flash_func(_stat_on_time)(bool on_time)
+{
+    if (!on_time)
+    {
+        _st_misses++;
+        _good_run = 0;
+        uint32_t g = (uint32_t)_guard_us + _guard_step_us;
+        _guard_us = (uint16_t)((g > _guard_max_us) ? _guard_max_us : g);
+        return;
+    }
+
+    if (++_good_run >= GOOD_RUN_SHRINK)
+    {
+        _good_run = 0;
+        if (_guard_us >= _guard_min_us + GUARD_SHRINK_STEP)
+            _guard_us -= GUARD_SHRINK_STEP;
+    }
+}
+
+static void _guard_setup(uint16_t init, uint16_t min, uint16_t max, uint16_t step)
+{
+    _guard_us = init;
+    _guard_min_us = min;
+    _guard_max_us = max;
+    _guard_step_us = step;
+    _good_run = 0;
+}
+
+void latch_stats_reset(void)
+{
+    uint32_t save = save_and_disable_interrupts();
+    _st_count = 0;
+    _st_min = UINT32_MAX;
+    _st_max = 0;
+    _st_sum = 0;
+    _st_misses = 0;
+    _read_max_us = 0;
+    restore_interrupts(save);
+}
+
+static uint32_t _lead_us(void)
+{
+    return _winmax(&_ready) + _guard_us;
+}
+
+// ---------------------------------------------------------------------------------------------
+// USB
+// ---------------------------------------------------------------------------------------------
+
+static volatile bool     _usb_on = false;
+static volatile uint32_t _sof_us = 0;
+static volatile bool     _sof_valid = false;
+
+static volatile int8_t   _usb_ep = -1;          // The game report's IN endpoint, learned on first arm
+static volatile bool     _usb_armed = false;    // A report sits in the endpoint
+static volatile uint32_t _usb_armed_input_us = 0;
+static volatile uint32_t _usb_armed_target_us = 0;
+static volatile bool     _usb_armed_has_target = false;
+
+static volatile int32_t  _usb_phase_us = 0;     // Host IN-complete offset after SOF
+static volatile uint32_t _usb_phase_n = 0;
+static volatile uint32_t _usb_last_take_us = 0;
+static volatile uint32_t _usb_take_interval_us = USB_FRAME_US; // Smoothed
+static volatile bool     _usb_have_take = false;
+
+static uint32_t _usb_next_take_us = 0;          // The take the next read is for
+static bool     _usb_next_valid = false;
+static uint32_t _usb_cur_target_us = 0;         // The take the newest read is for
+static bool     _usb_cur_target_valid = false;
+static uint32_t _usb_trig_us = 0;
+static bool     _usb_trig_valid = false;
+static bool     _usb_trig_busy = false;          // The endpoint was busy for this trigger's report
+static bool     _usb_trig_late = false;          // Noticed late (the loop was held up): a stall
+
+void latch_usb_start(void)
+{
+    uint32_t save = save_and_disable_interrupts();
+    _usb_on = true;
+    _sof_valid = false;
+    _usb_ep = -1;
+    _usb_armed = false;
+    _usb_phase_us = 0;
+    _usb_phase_n = 0;
+    _usb_have_take = false;
+    _usb_take_interval_us = USB_FRAME_US;
+    _usb_next_valid = false;
+    _usb_cur_target_valid = false;
+    _usb_trig_valid = false;
+    _usb_trig_busy = false;
+    _winmax_reset(&_ready);
+    _guard_setup(USB_GUARD_INIT_US, USB_GUARD_MIN_US, USB_GUARD_MAX_US, USB_GUARD_MISS_STEP);
+    _mode = LATCH_MODE_USB_FRAME;
+    restore_interrupts(save);
+}
+
+void latch_usb_stop(void)
+{
+    _usb_on = false;
+    _usb_armed = false;
+    if (_mode == LATCH_MODE_USB_FRAME || _mode == LATCH_MODE_USB_LATE)
+        _mode = LATCH_MODE_OFF;
+}
+
+void latch_usb_sof_isr(void)
+{
+    if (!_usb_on)
+        return;
+    _sof_us = time_us_32();
+    _sof_valid = true;
+}
+
+// The host took the armed report at t (interrupt context, or the task with interrupts off)
+static void _usb_take(uint32_t t)
+{
+    _usb_armed = false;
+
+    _stat_add(t - _usb_armed_input_us);
+
+    if (_usb_armed_has_target)
+    {
+        // Taken more than half a frame after the poll it was read for: it waited a whole frame
+        _stat_on_time((int32_t)(t - _usb_armed_target_us) <= (int32_t)(USB_FRAME_US / 2));
+    }
+
+    // Host poll phase within the frame, smoothed on the circle (an offset near 0 and one near
+    // 1000 are neighbours)
+    if (_sof_valid)
+    {
+        const uint32_t ph = t - _sof_us;
+        if (ph < USB_FRAME_US)
+        {
+            if (_usb_phase_n == 0)
+            {
+                _usb_phase_us = (int32_t)ph;
+            }
+            else
+            {
+                int32_t d = (int32_t)ph - _usb_phase_us;
+                if (d >= (int32_t)(USB_FRAME_US / 2))
+                    d -= (int32_t)USB_FRAME_US;
+                else if (d < -(int32_t)(USB_FRAME_US / 2))
+                    d += (int32_t)USB_FRAME_US;
+                int32_t p = _usb_phase_us + d / 8;
+                if (p < 0)
+                    p += (int32_t)USB_FRAME_US;
+                else if (p >= (int32_t)USB_FRAME_US)
+                    p -= (int32_t)USB_FRAME_US;
+                _usb_phase_us = p;
+            }
+            if (_usb_phase_n < 0xFFFFu)
+                _usb_phase_n++;
+        }
+    }
+
+    if (_usb_have_take)
+    {
+        const uint32_t iv = t - _usb_last_take_us;
+        if (iv < 20000u)
+            _usb_take_interval_us = _usb_take_interval_us + (uint32_t)(((int32_t)iv - (int32_t)_usb_take_interval_us) / 16);
+    }
+    _usb_last_take_us = t;
+    _usb_have_take = true;
+}
+
+void latch_usb_xfer_isr(void)
+{
+#if LATCH_HAS_USB_DPRAM
+    const int8_t ep = _usb_ep;
+    if (!_usb_armed || ep <= 0)
+        return;
+    // Another endpoint's transfer: ours is still waiting
+    if (usb_dpram->ep_buf_ctrl[ep].in & USB_BUF_CTRL_AVAIL)
+        return;
+    _usb_take(time_us_32());
+#endif
+}
+
+void latch_usb_armed(uint32_t input_us)
+{
+#if LATCH_HAS_USB_DPRAM
+    if (!_usb_on)
+        return;
+
+    const uint32_t now = time_us_32();
+
+    // Read start -> report armed: the time a read needs ahead of its poll
+    // A read held up by a long task (a flash write) is a stall: it neither stretches the lead for
+    // every report after it nor widens the guard (its age still counts in the stats)
+    const bool busy = _usb_trig_busy;
+    bool stalled = false;
+    if (_usb_trig_valid && !busy)
+    {
+        const uint32_t d = now - _usb_trig_us;
+        stalled = _usb_trig_late || (d > 2u * _winmax(&_ready) + 50u) || (d >= USB_READY_CAP_US);
+        if (!stalled)
+            _winmax_add(&_ready, d);
+    }
+    _usb_trig_valid = false;
+    _usb_trig_busy = false;
+
+    int8_t ep = _usb_ep;
+    if (ep <= 0)
+    {
+        // The endpoint just armed is the one waiting for the host. More than one waiting (the
+        // config app's endpoint too) leaves it for the next report.
+        int8_t found = -1;
+        uint8_t n = 0;
+        for (int8_t i = 1; i < 16; i++)
+        {
+            if (usb_dpram->ep_buf_ctrl[i].in & USB_BUF_CTRL_AVAIL)
+            {
+                found = i;
+                n++;
+            }
+        }
+        if (n != 1)
+            return;
+        _usb_ep = ep = found;
+    }
+
+    uint32_t save = save_and_disable_interrupts();
+    _usb_armed_input_us = input_us;
+    _usb_armed_target_us = _usb_cur_target_us;
+    _usb_armed_has_target = _usb_cur_target_valid && !busy && !stalled;
+    _usb_cur_target_valid = false;
+    _usb_armed = true;
+    // Taken already, between the send and here: its interrupt saw nothing armed
+    if (!(usb_dpram->ep_buf_ctrl[ep].in & USB_BUF_CTRL_AVAIL))
+        _usb_take(now);
+    restore_interrupts(save);
+#else
+    (void)input_us;
+#endif
+}
+
+bool latch_usb_endpoint_busy(void)
+{
+    _usb_trig_busy = true;
+    if (!_usb_trig_valid || (_mode != LATCH_MODE_USB_LATE))
+        return false;
+    // Dropped: nothing measured for it
+    _usb_trig_valid = false;
+    _usb_cur_target_valid = false;
+    return true;
+}
+
+bool latch_usb_active(void)
+{
+    const bool active = _enabled && _usb_on && _sof_valid && (_usb_phase_n >= USB_PHASE_LEARN_N) &&
+                        (_usb_take_interval_us < USB_TAKE_SLOW_US) && (_lead_us() < USB_FRAME_US - 50u);
+    if (_usb_on)
+        _mode = active ? LATCH_MODE_USB_LATE : LATCH_MODE_USB_FRAME;
+    if (!active)
+        _usb_next_valid = false;
+    return active;
+}
+
+bool latch_usb_due(void)
+{
+    if (!latch_usb_active())
+        return false;
+
+    const uint32_t now = time_us_32();
+    const uint32_t lead = _lead_us();
+    const uint32_t predicted = _sof_us + (uint32_t)_usb_phase_us; // This frame's take (may be past)
+
+    if (_usb_next_valid)
+    {
+        // Follow the prediction: the host's clock and ours drift apart a little every frame
+        int32_t d = (int32_t)(predicted - _usb_next_take_us) % (int32_t)USB_FRAME_US;
+        if (d >= (int32_t)(USB_FRAME_US / 2))
+            d -= (int32_t)USB_FRAME_US;
+        else if (d < -(int32_t)(USB_FRAME_US / 2))
+            d += (int32_t)USB_FRAME_US;
+        _usb_next_take_us += (uint32_t)d;
+
+        // Fell more than a frame behind (a long stall): start over from the next take in reach
+        if ((int32_t)(now - _usb_next_take_us) > (int32_t)USB_FRAME_US)
+            _usb_next_valid = false;
+    }
+
+    if (!_usb_next_valid)
+    {
+        uint32_t t = predicted;
+        while ((int32_t)(t - now) < (int32_t)lead)
+            t += USB_FRAME_US;
+        _usb_next_take_us = t;
+        _usb_next_valid = true;
+    }
+
+    const uint32_t start = _usb_next_take_us - lead;
+    if (!AT_OR_AFTER(now, start))
+        return false;
+
+    _usb_trig_late = (now - start) > (uint32_t)(_guard_us / 2);
+
+    _usb_cur_target_us = _usb_next_take_us;
+    _usb_cur_target_valid = true;
+    _usb_next_take_us += USB_FRAME_US;
+    _usb_trig_us = now;
+    _usb_trig_valid = true;
+    _usb_trig_busy = false;
+    _read_trigger(now);
+    return true;
+}
+
+// ---------------------------------------------------------------------------------------------
+// Joybus
+// ---------------------------------------------------------------------------------------------
+
+static volatile bool     _jb_on = false;
+static volatile uint32_t _jb_last_poll_us = 0;
+static volatile bool     _jb_have_poll = false;
+static volatile uint32_t _jb_period_us = 0;
+static volatile uint8_t  _jb_steady = 0;
+static volatile bool     _jb_trig_since_poll = false;
+
+static volatile uint32_t _jb_snap_input_us = 0;
+static volatile bool     _jb_snap_valid = false;
+static volatile uint32_t _jb_meant_start_us = 0;   // The read scheduled for the coming poll began
+static volatile bool     _jb_meant_valid = false;
+static uint32_t _jb_trig_us = 0;
+static bool     _jb_trig_valid = false;
+
+void latch_jb_start(void)
+{
+    uint32_t save = save_and_disable_interrupts();
+    _jb_on = true;
+    _jb_have_poll = false;
+    _jb_period_us = 0;
+    _jb_steady = 0;
+    _jb_trig_since_poll = false;
+    _jb_snap_valid = false;
+    _jb_meant_valid = false;
+    _jb_trig_valid = false;
+    _winmax_reset(&_ready);
+    _guard_setup(JB_GUARD_INIT_US, JB_GUARD_MIN_US, JB_GUARD_MAX_US, JB_GUARD_MISS_STEP);
+    _mode = LATCH_MODE_JB_FREE;
+    restore_interrupts(save);
+}
+
+void latch_jb_stop(void)
+{
+    _jb_on = false;
+    if (_mode == LATCH_MODE_JB_FREE || _mode == LATCH_MODE_JB_LOCKED)
+        _mode = LATCH_MODE_OFF;
+}
+
+void __not_in_flash_func(latch_jb_poll_isr)(uint32_t poll_us)
+{
+    if (!_jb_on)
+        return;
+
+    if (_jb_have_poll)
+    {
+        const uint32_t d = poll_us - _jb_last_poll_us;
+        if (d >= JB_PERIOD_MIN_US && d <= JB_PERIOD_MAX_US)
+        {
+            const uint32_t p = _jb_period_us;
+            const uint32_t diff = (d > p) ? (d - p) : (p - d);
+            if (p && diff <= (p >> 4) + 20u)
+            {
+                _jb_period_us = p + (uint32_t)(((int32_t)d - (int32_t)p) / 8);
+                if (_jb_steady < 255)
+                    _jb_steady++;
+            }
+            else
+            {
+                _jb_period_us = d;
+                _jb_steady = 0;
+            }
+        }
+        else
+        {
+            _jb_steady = 0;
+        }
+    }
+    _jb_last_poll_us = poll_us;
+    _jb_have_poll = true;
+    _jb_trig_since_poll = false;
+
+    if (_jb_snap_valid)
+    {
+        _stat_add(poll_us - _jb_snap_input_us);
+        // A read was scheduled for this poll: did it make it into the answer?
+        if (_jb_meant_valid)
+            _stat_on_time(AT_OR_AFTER(_jb_snap_input_us, _jb_meant_start_us));
+    }
+    _jb_meant_valid = false;
+}
+
+void latch_jb_snapshot(uint32_t input_us)
+{
+    if (!_jb_on)
+        return;
+    if (_jb_trig_valid)
+    {
+        const uint32_t d = time_us_32() - _jb_trig_us;
+        if (d <= 2u * _winmax(&_ready) + 50u)
+            _winmax_add(&_ready, d);
+        else
+            _jb_meant_valid = false; // Stalled: not the schedule's miss
+        _jb_trig_valid = false;
+    }
+    _jb_snap_input_us = input_us;
+    _jb_snap_valid = true;
+}
+
+bool latch_jb_locked(void)
+{
+    const uint32_t period = _jb_period_us;
+    const bool locked = _enabled && _jb_on && _jb_have_poll && (_jb_steady >= JB_LOCK_N) &&
+                        (period >= JB_PERIOD_MIN_US) && (_lead_us() + 50u < period);
+    if (_jb_on)
+        _mode = locked ? LATCH_MODE_JB_LOCKED : LATCH_MODE_JB_FREE;
+    return locked;
+}
+
+static uint32_t _jb_next_poll(uint32_t now)
+{
+    const uint32_t period = _jb_period_us;
+    uint32_t t = _jb_last_poll_us + period;
+    // Polls skipped (paused game, a reset): aim at the next one on the same rhythm
+    uint8_t guard = 0;
+    while ((int32_t)(now - t) > (int32_t)(period / 2) && guard++ < 64)
+        t += period;
+    return t;
+}
+
+bool latch_jb_due(void)
+{
+    if (!latch_jb_locked())
+        return false;
+    if (_jb_trig_since_poll)
+        return false;
+
+    const uint32_t now = time_us_32();
+    const uint32_t next = _jb_next_poll(now);
+    const uint32_t start = next - _lead_us();
+    if (!AT_OR_AFTER(now, start))
+        return false;
+
+    _jb_trig_since_poll = true;
+    _jb_meant_start_us = now;
+    // Noticed late (the loop was held up): a stall, not the schedule's miss
+    _jb_meant_valid = (now - start) <= (uint32_t)(_guard_us / 2);
+    _jb_trig_us = now;
+    _jb_trig_valid = true;
+    _read_trigger(now);
+    return true;
+}
+
+// ---------------------------------------------------------------------------------------------
+
+uint32_t latch_next_start_us(bool *valid, uint32_t *period_us)
+{
+    if (_read_pending && (_mode == LATCH_MODE_USB_LATE || _mode == LATCH_MODE_JB_LOCKED))
+    {
+        *valid = true;
+        *period_us = (_mode == LATCH_MODE_USB_LATE) ? USB_FRAME_US : _jb_period_us;
+        return _read_pending_at;
+    }
+    if (_mode == LATCH_MODE_USB_LATE && _usb_next_valid)
+    {
+        *valid = true;
+        *period_us = USB_FRAME_US;
+        return _usb_next_take_us - _lead_us();
+    }
+    if (_mode == LATCH_MODE_JB_LOCKED && !_jb_trig_since_poll)
+    {
+        *valid = true;
+        *period_us = _jb_period_us;
+        return _jb_next_poll(time_us_32()) - _lead_us();
+    }
+    *valid = false;
+    return 0;
+}
+
+void latch_stats_get(latch_stats_s *out)
+{
+    memset(out, 0, sizeof(*out));
+    uint32_t save = save_and_disable_interrupts();
+    const uint32_t count = _st_count;
+    const uint64_t sum = _st_sum;
+    out->count = count;
+    out->age_min_us = count ? _st_min : 0;
+    out->age_max_us = _st_max;
+    out->misses = _st_misses;
+    restore_interrupts(save);
+
+    out->version = LATCH_STATS_VERSION;
+    out->mode = (uint8_t)_mode | (_enabled ? 0 : 0x80); // Top bit: switched off (stock timing)
+    out->guard_us = _guard_us;
+    out->age_avg_us = count ? (uint32_t)(sum / count) : 0;
+    out->lead_us = _lead_us();
+    out->read_us = _read_dur_us;
+    out->read_max_us = _read_max_us;
+
+    switch (_mode)
+    {
+    case LATCH_MODE_USB_FRAME:
+    case LATCH_MODE_USB_LATE:
+        out->phase_us = (uint32_t)_usb_phase_us;
+        break;
+    case LATCH_MODE_JB_FREE:
+    case LATCH_MODE_JB_LOCKED:
+        out->phase_us = _jb_period_us;
+        break;
+    default:
+        break;
+    }
+}
