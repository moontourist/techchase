diff --git a/include/input/macros/macro_quick_remap.h b/include/input/macros/macro_quick_remap.h
new file mode 100644
index 0000000..2ea6be6
--- /dev/null
+++ b/include/input/macros/macro_quick_remap.h
@@ -0,0 +1,36 @@
+#ifndef MACRO_QUICK_REMAP_H
+#define MACRO_QUICK_REMAP_H
+
+// techchase: remap buttons on the controller itself, no PC needed, in the style of Smash
+// Ultimate's controls screen. Works in every mode and game: it rewrites the firmware's mapping.
+//
+//   Hold Power + Start 1.5 s   -> Quick Remap on (power LED pulses purple, one tick). The game sees
+//                                 the controller at rest until it's off again.
+//   Press the button to change -> one tick
+//   Press the button whose job it should do -> two ticks + green flash, stored at once
+//                                 (the same button twice: back to its own default)
+//   Hold Start 3 s             -> every button back to default (orange flash, three ticks)
+//   Press Power                -> off (or 20 s without a press)
+//
+// The modifier is the board's shipping/power button (hoja_config_s.shipping_macro_code[0]), or
+// Home on a board without one.
+
+#include <stdint.h>
+#include <stdbool.h>
+#include "input_shared_types.h"
+
+void macro_quick_remap(uint64_t timestamp, mapper_input_s *input);
+
+// The game's path holds at rest: on, or the combo held (mapper_get_input, every report)
+bool macro_quick_remap_game_hold(const mapper_input_s *input);
+
+// Holding Power must not shut down: on, just turned off, or Power held with another button
+bool macro_quick_remap_blocks_shutdown(const mapper_input_s *input);
+
+bool macro_quick_remap_active(void);
+
+// For WebUSB / the desktop tool: the same changes, stored at once
+bool macro_quick_remap_assign(mapper_input_code_t src, mapper_input_code_t target);
+void macro_quick_remap_reset_all(void);
+
+#endif
