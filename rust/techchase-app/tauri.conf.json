{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "techchase",
  "version": "0.1.0",
  "identifier": "io.github.moontourist.techchase",
  "build": {
    "frontendDist": "../../tools/app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "techchase",
        "width": 1200,
        "height": 860,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
